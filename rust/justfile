# Build recipes for the Rust simplifier/checker workspace.
#
# FLINT backend: simplifier depends on flint3-sys 3.6 (see
# src/poly_factor/ffi.rs), which builds on both Linux and macOS — no
# per-platform dependency swap needed.

# Native build.
build:
    cargo build --release

# macOS build against a custom z3. FLINT 3.6 is compiled from source via
# autotools on first build, so the first run takes a few minutes. `z3dir`
# must contain libz3.dylib.
build-osx z3dir:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v autoreconf >/dev/null || {
        echo "error: autoreconf not found — flint3-sys builds FLINT from source." >&2
        echo "       install autotools: brew install autoconf automake libtool" >&2
        exit 1
    }
    [ -f "{{z3dir}}/libz3.dylib" ] || {
        echo "error: {{z3dir}}/libz3.dylib not found (need a z3 build dir)." >&2
        exit 1
    }
    Z3_LIB_DIR="{{z3dir}}" cargo build --release -p simplifier

# Arie's machine: custom z3 at ~/ag/z3/wt-master/build.
build-ag: (build-osx (env_var('HOME') / "ag/z3/wt-master/build"))
