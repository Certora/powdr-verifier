# Build recipes for the Rust simplifier/checker workspace.
#
# Linking is handled entirely by z3-sys's own build script (there is no build.rs
# here any more); it reads the environment that ../z3-env.sh exports. Source
# that first, or use the recipes below, which do it for you.

# Everything: all three crates, release, against the workspace SDK.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{justfile_directory()}}/../z3-env.sh"
    cargo build --release --workspace

# Everything, plus the test binaries, then run them.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{justfile_directory()}}/../z3-env.sh"
    cargo test --release --workspace

# Type-check everything without linking. Fastest way to catch a bad z3 bump.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{justfile_directory()}}/../z3-env.sh"
    cargo check --release --workspace

# Everything, inside a nono sandbox. Extra args go to cargo.
build-sandboxed *args:
    #!/usr/bin/env bash
    # Two things trip up a hand-written `nono run -- cargo build`: the sandbox
    # has to be told about the z3 SDK, which lives outside the cwd tree, and
    # the environment still has to be sourced or the linker gets a bare -lz3
    # with no -L to resolve it. Both are handled here, and $Z3_PREFIX is
    # derived rather than typed, so it stays right when the pin moves.
    #   just build-sandboxed -p simplifier
    set -euo pipefail
    source "{{justfile_directory()}}/../z3-env.sh"
    command -v nono >/dev/null || { echo "error: nono not on PATH." >&2; exit 1; }
    nono run \
        --allow-cwd \
        --allow-file "$HOME/.gitconfig" \
        --allow "$HOME/.cache" \
        --allow "$HOME/.rustup" \
        --allow "$HOME/.cargo" \
        --allow "{{justfile_directory()}}/target" \
        --allow "$Z3_PREFIX" \
        -- cargo build --release --workspace {{args}}

# Build against some other z3, e.g. a local checkout's build dir.
build-with z3dir:
    #!/usr/bin/env bash
    # Pass the directory holding libz3.{dylib,so,a}. FLINT compiles from source
    # on first run, hence the autotools check.
    set -euo pipefail
    command -v autoreconf >/dev/null || {
        echo "error: autoreconf not found — flint3-sys builds FLINT from source." >&2
        echo "       install autotools: brew install autoconf automake libtool" >&2
        exit 1
    }
    shopt -s nullglob
    libs=("{{z3dir}}"/libz3.dylib "{{z3dir}}"/libz3.so "{{z3dir}}"/libz3.a)
    [ "${#libs[@]}" -gt 0 ] || {
        echo "error: no libz3.{dylib,so,a} in {{z3dir}}." >&2
        exit 1
    }
    # Same three knobs z3-env.sh sets, pointed somewhere else. Z3_SYS_Z3_VERSION
    # is what z3-sys reports to the `z3` crate for its version-gated APIs; with
    # pkg-config disabled it has no other way to find out, so state it here.
    export Z3_LIBRARY_PATH_OVERRIDE="{{z3dir}}"
    export Z3_NO_PKG_CONFIG=1
    export Z3_SYS_Z3_VERSION="${Z3_SYS_Z3_VERSION:-5.1.0}"
    export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C link-arg=-Wl,-rpath,{{z3dir}}"
    cargo build --release -p simplifier
